{
  "name": "ai-product-leadership-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Executive operating platform for governing, prioritizing, funding, evaluating and optimizing an enterprise AI product portfolio.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:seeded": "cross-env VITE_DATA_MODE=seeded vite build --base=/AI-Product-Leadership-Studio/seeded/ --outDir=dist/seeded --emptyOutDir=false",
    "build:all": "npm run build && npm run build:seeded",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:isolation": "node --test server/tenant-isolation.test.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.400.0",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "recharts": "^2.12.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.1.9",
    "wrangler": "^4.124.0"
  }
}
